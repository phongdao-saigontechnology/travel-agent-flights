# LLM Provider Selection
# Options: "openai" (default) or "azure_openai"
LLM_PROVIDER=openai

# OpenAI Configuration (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key

# Azure OpenAI Configuration (required when LLM_PROVIDER=azure_openai)
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Amadeus API Configuration
AMADEUS_CLIENT_ID=your_amadeus_api_key
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret
AMADEUS_HOSTNAME=test  # "test" for sandbox, "production" for live

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Agent Configuration
MAX_ITERATIONS=25
TEMPERATURE=0.1

# LangSmith Tracing (optional)
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_PROJECT=travel-agent
# LANGSMITH_TRACING=false
